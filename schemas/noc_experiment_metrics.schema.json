{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.openclaw.dev/schemas/noc_experiment_metrics.schema.json",
  "title": "NOC LegoLink Experiment Metrics",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "metric_level",
    "variant",
    "measurement_kind"
  ],
  "properties": {
    "metric_level": {
      "type": "string",
      "enum": [
        "request",
        "agent_step",
        "task",
        "experiment",
        "cuda_component",
        "host_timing",
        "profiler_component",
        "nsight_run"
      ]
    },
    "variant": {
      "type": "string",
      "enum": [
        "full_context_original_sglang",
        "selected_context_original_sglang",
        "selected_context_radixcache_legolink",
        "picruntime_owner",
        "radixcache_owner",
        "original_sglang"
      ]
    },
    "measurement_kind": {
      "type": "string",
      "enum": [
        "formal_latency",
        "diagnostic_cuda_event",
        "diagnostic_pytorch_profiler",
        "diagnostic_nsight",
        "diagnostic_nsight_systems",
        "diagnostic_host_timing",
        "paired_replay",
        "official_agent",
        "wildclaw_long_running"
      ]
    },
    "task_id": { "type": ["string", "null"] },
    "request_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "session_revision": { "type": ["integer", "null"], "minimum": 0 },
    "trial_id": { "type": ["string", "null"] },
    "phase": { "type": ["string", "null"] },
    "context_stratum": { "type": ["string", "null"] },
    "k": { "type": ["integer", "null"], "minimum": 0 },
    "decode_iteration": { "type": ["integer", "null"], "minimum": 0 },
    "warmup": { "type": ["boolean", "null"] },
    "warmup_repeats": { "type": ["integer", "null"], "minimum": 0 },
    "fixed_output_length": { "type": ["boolean", "null"] },
    "completion_length_equal": { "type": ["boolean", "null"] },
    "cache_accounting_source": { "type": ["string", "null"] },
    "concurrency": { "type": ["integer", "null"], "minimum": 1 },
    "sample_count": { "type": ["integer", "null"], "minimum": 0 },
    "mean_s": { "type": ["number", "null"] },
    "std_s": { "type": ["number", "null"] },
    "p50_s": { "type": ["number", "null"] },
    "p95_s": { "type": ["number", "null"] },
    "min_s": { "type": ["number", "null"] },
    "max_s": { "type": ["number", "null"] },
    "request_latency_ms": { "type": ["number", "null"] },
    "e2e_latency_ms": { "type": ["number", "null"] },
    "step_latency_ms": { "type": ["number", "null"] },
    "planning_latency_ms": { "type": ["number", "null"] },
    "replanning_latency_ms": { "type": ["number", "null"] },
    "total_llm_latency_ms": { "type": ["number", "null"] },
    "tool_execution_time_ms": { "type": ["number", "null"] },
    "context_management_latency_ms": { "type": ["number", "null"] },
    "segmentation_latency_ms": { "type": ["number", "null"] },
    "selection_latency_ms": { "type": ["number", "null"] },
    "compile_latency_ms": { "type": ["number", "null"] },
    "compile_inclusive_latency_ms": { "type": ["number", "null"] },
    "environment_setup_latency_ms": { "type": ["number", "null"] },
    "agent_latency_ms": { "type": ["number", "null"] },
    "grader_latency_ms": { "type": ["number", "null"] },
    "ttft_ms": { "type": ["number", "null"] },
    "prefill_ms": { "type": ["number", "null"] },
    "link_ms": { "type": ["number", "null"] },
    "total_prefill_or_link_time_ms": { "type": ["number", "null"] },
    "decode_ms": { "type": ["number", "null"] },
    "queue_wait_ms": { "type": ["number", "null"] },
    "itl_mean_ms": { "type": ["number", "null"] },
    "itl_p50_ms": { "type": ["number", "null"] },
    "itl_p95_ms": { "type": ["number", "null"] },
    "output_tokens_per_second": { "type": ["number", "null"] },
    "requests_per_second": { "type": ["number", "null"] },
    "llm_requests_per_minute": { "type": ["number", "null"] },
    "prompt_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "backend_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "backend_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "local_model_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "local_model_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "full_session_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "selected_context_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "context_reduction_ratio": { "type": ["number", "null"], "minimum": 0 },
    "context_reduction_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "candidate_context_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "mutable_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "compiled_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "compiled_blocks": { "type": ["integer", "null"], "minimum": 0 },
    "number_of_blocks": { "type": ["integer", "null"], "minimum": 0 },
    "new_compiled_blocks": { "type": ["integer", "null"], "minimum": 0 },
    "unique_semantic_blocks": { "type": ["integer", "null"], "minimum": 0 },
    "linked_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "reused_blocks": { "type": ["integer", "null"], "minimum": 0 },
    "reused_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "recomputed_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "cache_reuse_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "recompute_ratio": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "cache_hits": { "type": ["integer", "null"], "minimum": 0 },
    "cache_misses": { "type": ["integer", "null"], "minimum": 0 },
    "evicted_blocks": { "type": ["integer", "null"], "minimum": 0 },
    "evicted_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "fallback_count": { "type": ["integer", "null"], "minimum": 0 },
    "recovery_success_count": { "type": ["integer", "null"], "minimum": 0 },
    "superseded_blocks": { "type": ["integer", "null"], "minimum": 0 },
    "invalidated_blocks": { "type": ["integer", "null"], "minimum": 0 },
    "average_reuse_count_per_block": { "type": ["number", "null"], "minimum": 0 },
    "new_tool_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
    "selected_blocks": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "excluded_blocks": {
      "type": ["array", "null"],
      "items": { "type": "string" }
    },
    "task_state": { "type": ["string", "null"] },
    "exact": { "type": ["boolean", "null"] },
    "exact_rate": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "similarity": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "similarity_mean": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "task_success": { "type": ["boolean", "null"] },
    "verifier_pass": { "type": ["boolean", "null"] },
    "verifier_score": { "type": ["number", "null"] },
    "timeout": { "type": ["boolean", "null"] },
    "oom": { "type": ["boolean", "null"] },
    "error": { "type": ["string", "null"] },
    "failure_mode": { "type": ["string", "null"] },
    "agent_steps": { "type": ["integer", "null"], "minimum": 0 },
    "llm_calls": { "type": ["integer", "null"], "minimum": 0 },
    "tool_calls": { "type": ["integer", "null"], "minimum": 0 },
    "successful_tool_calls": { "type": ["integer", "null"], "minimum": 0 },
    "failed_tool_calls": { "type": ["integer", "null"], "minimum": 0 },
    "planner_calls": { "type": ["integer", "null"], "minimum": 0 },
    "replanner_calls": { "type": ["integer", "null"], "minimum": 0 },
    "repeated_action_count": { "type": ["integer", "null"], "minimum": 0 },
    "invalid_tool_call_count": { "type": ["integer", "null"], "minimum": 0 },
    "completed_tasks": { "type": ["integer", "null"], "minimum": 0 },
    "failed_tasks": { "type": ["integer", "null"], "minimum": 0 },
    "timeout_tasks": { "type": ["integer", "null"], "minimum": 0 },
    "error_tasks": { "type": ["integer", "null"], "minimum": 0 },
    "oom_tasks": { "type": ["integer", "null"], "minimum": 0 },
    "average_steps_per_task": { "type": ["number", "null"], "minimum": 0 },
    "max_steps": { "type": ["integer", "null"], "minimum": 0 },
    "tasks_per_hour": { "type": ["number", "null"] },
    "successful_tasks_per_gpu_hour": { "type": ["number", "null"] },
    "steps_per_minute": { "type": ["number", "null"] },
    "effective_batch_size": { "type": ["number", "null"], "minimum": 0 },
    "active_request_count": { "type": ["integer", "null"], "minimum": 0 },
    "prefill_batch_size": { "type": ["integer", "null"], "minimum": 0 },
    "decode_batch_size": { "type": ["integer", "null"], "minimum": 0 },
    "component": { "type": ["string", "null"] },
    "elapsed_ms": { "type": ["number", "null"] },
    "profiling_type": {
      "type": ["string", "null"],
      "enum": [
        null,
        "cuda_event",
        "pytorch_profiler",
        "nsight",
        "nsight_systems",
        "host_timing"
      ]
    },
    "formal_latency": { "type": ["boolean", "null"] },
    "diagnostic": { "type": ["boolean", "null"] }
  }
}
