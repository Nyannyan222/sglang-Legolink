{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SemanticSubContext",
  "type": "object",
  "additionalProperties": false,
  "required": ["sub_context_id", "task_id", "session_revision", "context_field", "title", "question_or_objective", "raw_text", "canonical_text", "source_spans", "content_hash", "cache_key", "version", "token_count", "token_ids", "tokenizer_fingerprint", "model_fingerprint", "recompute_policy_version", "is_mutable", "reuse_candidate", "semantic_independence_reason", "segmentation_confidence", "policy_version", "created_at", "updated_at", "invalidated"],
  "properties": {
    "sub_context_id": {"type": "string"},
    "task_id": {"type": "string"},
    "session_revision": {"type": "integer", "minimum": 1},
    "context_field": {"enum": ["user_prompt", "task_instruction", "tool_definitions", "tool_history_output", "conversation_history", "workspace_evidence", "task_metadata"]},
    "title": {"type": "string"},
    "question_or_objective": {"type": "string"},
    "raw_text": {"type": "string"},
    "canonical_text": {"type": "string"},
    "source_spans": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["source_id", "start", "end"], "properties": {"source_id": {"type": "string"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}}},
    "content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cache_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "version": {"type": "integer", "minimum": 1},
    "token_count": {"type": "integer", "minimum": 0},
    "token_ids": {"type": "array"},
    "tokenizer_fingerprint": {"type": "string", "minLength": 1},
    "model_fingerprint": {"type": "string", "minLength": 1},
    "recompute_policy_version": {"type": "string", "minLength": 1},
    "is_mutable": {"type": "boolean"},
    "reuse_candidate": {"type": "boolean"},
    "semantic_independence_reason": {"type": "string"},
    "segmentation_confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "policy_version": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "supersedes": {"type": ["string", "null"]},
    "invalidated": {"type": "boolean"},
    "derived_from": {"type": "array", "items": {"type": "string"}},
    "metadata": {"type": "object"}
  }
}
