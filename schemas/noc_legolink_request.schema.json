{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NOCLogicalLegoLinkRequest",
  "description": "Client-side contract validated before an OpenAI-compatible pic_link request is sent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "semantic_block_ids",
    "cache_keys",
    "mutable_text",
    "generation_parameters"
  ],
  "properties": {
    "request_id": {"type": "string", "minLength": 1},
    "semantic_block_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "cache_keys": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "mutable_text": {
      "type": "string",
      "minLength": 1,
      "description": "Required because PICRuntime returns logits for the final mutable token."
    },
    "generation_parameters": {"type": "object"}
  }
}
