+    def _drop_compile_record(self, owner_id: int, *, restore: bool) -> Optional[_CompileRecord]:
+        record = self._compile_records.pop(owner_id, None)
+        if record is None:
+            return None
+        owners = self._inflight_owners.get(record.cache_key, [])
+        if owner_id in owners:
