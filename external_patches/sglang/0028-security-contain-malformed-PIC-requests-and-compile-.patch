             self._add_request_to_queue(req)
             return
 
+        # A Link cannot return input-token logprobs, and the result processor
+        # asserts rather than skips when they are missing. Refuse it here, as a
+        # request-scoped error, instead of in the event loop.
+        error_msg = validate_pic_link_logprob_request(
+            req.sampling_params,
+            return_logprob=bool(req.return_logprob),
+            logprob_start_len=req.logprob_start_len,
+            input_length=len(req.origin_input_ids),
+        )
+        if error_msg:
+            req.set_finish_with_abort(error_msg)
+            self._add_request_to_queue(req)
+            return
+
         if recv_req.return_routed_experts:
             error_msg = None
